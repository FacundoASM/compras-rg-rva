# ============================================================================
# Compras RG-RVA · Variables de entorno
# ============================================================================
# Copiar este archivo como .env.local y completar los valores.
# En Vercel se cargan en Settings → Environment Variables (los tres entornos).
#
#   cp .env.example .env.local
#   chmod 600 .env.local
#
# .env.local NO se sube al repositorio (está en .gitignore). Verificar que siga
# siendo así antes de cada commit.
# ============================================================================

# Dirección del proyecto de Supabase.
# Nube:  https://xxxxxxxxxxxx.supabase.co
# Local: http://compras.radiovictoria.local:8000
#        (tiene que ser alcanzable desde los navegadores de la red, no localhost)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública. Es visible en el navegador por diseño: sola no puede hacer nada,
# porque las políticas de seguridad de la base (RLS) limitan qué ve cada usuario.
# Panel de Supabase → Project Settings → API → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de administración. SALTEA TODAS LAS REGLAS DE SEGURIDAD DE LA BASE.
# Solo se usa del lado del servidor, para que el superusuario pueda blanquear
# contraseñas desde la pantalla de Perfiles.
#
#   - Nunca ponerla en un archivo que llegue al navegador.
#   - Nunca subirla al repositorio.
#   - Si se filtra, rotarla de inmediato desde el panel de Supabase.
#
# Panel de Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
